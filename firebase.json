{
  "hosting": {
    "public": ".",

    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],

    "rewrites": [

      {
        "source": "/register",
        "destination": "/register.html"
      },

      {
        "source": "/mail",
        "destination": "/mail.html"
      },

      {
        "source": "/inbox",
        "destination": "/inbox.html"
      },

      {
        "source": "/search",
        "destination": "/search.html"
      },

      {
        "source": "**",
        "destination": "/index.html"
      }

    ]
  }
}